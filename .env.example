REVIEW_MODEL=gemma4:12b
TRANSLATE_MODEL=translategemma:12b

# 以下は review モデルの eval 用のノブである。
# 3 つとも未設定なら baseline 構成、つまりこれらを導入する前と同じ挙動になる。
# 値が不正なら ai-api は起動時に落ちる。黙って baseline に落ちると、別構成のつもりで
# baseline の数字を記録してしまうためである。

# none（既定）なら prompt 1 通。prefix なら system message と本文の 2 通に分ける。
REVIEW_SYSTEM_MODE=

# Ollama の think パラメータ。true / false / low / medium / high / max のいずれか。
REVIEW_THINK=

# 1 または true なら、invalid_model_output の 502 にモデルの生出力と thinking を載せる。
REVIEW_DEBUG_RAW=
